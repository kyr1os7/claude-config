{
  "mcpServers": {
    "kintone": {
      "type": "stdio",
      "command": "/usr/local/bin/node",
      "args": ["/Users/YOUR_USERNAME/.npm-global/bin/kintone-mcp-server"],
      "env": {
        "KINTONE_BASE_URL": "https://YOUR_DOMAIN.cybozu.com",
        "KINTONE_USERNAME": "YOUR_EMAIL@domain.com",
        "KINTONE_PASSWORD": "YOUR_PASSWORD"
      }
    }
  }
}
